{
  "version": 1,
  "project": "thundr-go",
  "default_scope": "desktop-ui",
  "privacy": {
    "access": "explicit-allowlist-only",
    "archives": "never-open",
    "runtime_data": "never-open",
    "symlinks": "reject",
    "note": "Only the source files listed below are readable by the helper. Deny rules override the allowlist."
  },
  "scopes": {
    "desktop-ui": {
      "description": "Desktop Console markup, behavior, styles, mock parity, and UI contract tests. No bot runtime changes.",
      "keywords": ["desktop", "ui", "frontend", "tab", "button", "form", "theme", "layout", "logs", "console"],
      "files": [
        {
          "path": "src/frontend/dist/index.html",
          "role": "Desktop markup, panels, controls, and DOM ids",
          "editable": true,
          "anchors": ["data-panel=\"home\"", "data-panel=\"logs\"", "./app.js"]
        },
        {
          "path": "src/frontend/dist/app.js",
          "role": "Desktop state, bridge calls, rendering, event wiring, and startup",
          "editable": true,
          "anchors": ["function activateTab", "function applySnapshot", "function bindActions", "async function bootstrap"]
        },
        {
          "path": "src/frontend/dist/styles.css",
          "role": "Design tokens, layout, controls, themes, and responsive rules",
          "editable": true,
          "anchors": [":root", ".nav-button", ".tab-panel", "@media"]
        },
        {
          "path": "src/frontend/dist/js/mock-backend.js",
          "role": "Offline demo backend used when Wails and HTTP are unavailable",
          "editable": true,
          "anchors": ["async GetSnapshot(", "async SaveSettings(", "window.__consoleMock"]
        },
        {
          "path": "tests/contract.test.cjs",
          "role": "UI-to-mock-to-Go method parity, DOM ids, and source hygiene checks",
          "editable": true,
          "anchors": ["every method called by the UI exists in the mock", "every DOM id the JS uses exists in index.html"]
        }
      ],
      "checks": [
        "node --check src/frontend/dist/app.js",
        "node --check src/frontend/dist/js/mock-backend.js",
        "node --test tests/contract.test.cjs",
        "node --test tests/project-manager.test.cjs"
      ]
    },
    "dashboard-reliability": {
